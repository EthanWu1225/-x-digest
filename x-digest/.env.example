# ─────────────────────────────────────────────────────────
# x-digest 配置。复制成 .env 后按注释填写。
# 任何一项留空即走对应默认值（见 README「配置表」）。
# ─────────────────────────────────────────────────────────

# ===== 1. 要刷谁 =====
# 逗号分隔，不带 @。可以是任意公开账号。
# 想让机器人在 X 上"帮你盯人"，就把关注的人写进来。
WATCH_HANDLES=sama,karpathy,deepseek_ai

# 你的 X 账号（不带 @）。机器人会 @ 你 / 回复你。
TARGET_HANDLE=your_handle

# 每次最多挑几条推给你（1-3 最舒服，多了像刷屏）
MAX_PICKS=2

# ===== 2. 机器人账号的 API 凭据（要"发推"必须填）=====
# 在 https://developer.x.com 建 App，权限选 Read and write，
# 生成 Consumer Key/Secret 和 Access Token/Secret（用户上下文）。
X_CONSUMER_KEY=
X_CONSUMER_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=

# 可选：如果有付费 API 档，填 Bearer 就用官方 v2 读时间线（比抓网页稳）
X_BEARER_TOKEN=

# ===== 3. DeepSeek 用来"判断什么值得看" =====
# 就是 DeepSeek 开放平台的 key：https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# ===== 4. 发不发 =====
# off   = 只打印不发送（默认，先看效果）
# reply = 回复你最近一条推（最像"@你"，且不会单独刷屏）
# mention = 直接发一条 @ 你的推
POST_MODE=off

# 一天最多发几条 / 两条之间至少隔几分钟（防刷屏、防风控）
MAX_POSTS_PER_DAY=3
MIN_INTERVAL_MINUTES=90

# 免打扰时段（本地时区），这个区间内只记录不发
QUIET_START=23:00
QUIET_END=08:00
TZ=Asia/Shanghai

# ===== 5. 节奏与抓取 =====
# 每多少分钟刷一次（建议 30-60，太快会被 X 限流）
POLL_INTERVAL_MINUTES=30

# 每个账号抓多少条 / 单次最多交给模型多少条
LIMIT_PER_HANDLE=20
MAX_CANDIDATES=60

# 请求超时（毫秒）
FETCH_TIMEOUT_MS=15000

# ===== 6. 给自己看的小接口 =====
# 设了以后可以用 GET /timeline 给 DSH 里的 agent 当数据源
# 注意：这个 token 会出现在 URL 里（方便 web_fetch 调用），别用弱口令
DIGEST_TOKEN=change-me
# 只监听本机最安全；要从别的机器访问建议 SSH 隧道（ssh -L 8788:127.0.0.1:8788）
HOST=127.0.0.1
PORT=8788

# 数据目录（状态、日志）
DATA_DIR=./data

# ===== 7. 互动层：cookie 会话 + 审核队列 =====
# 小号的浏览器 cookie 存这个文件：{"auth_token":"...","ct0":"..."}
# 有了它，服务也能直接读「你关注的时间线」，不再依赖那个会被 429 的匿名接口
X_COOKIES_FILE=./data/x-cookies.json

# 私信只允许发给白名单里的人（数字 id 或 @handle，逗号分隔）。留空 = 只能发给自己
DM_WHITELIST=

# 每天最多发几条回复 / 几条私信（审核通过才算数）
REPLY_DAILY_LIMIT=5
DM_DAILY_LIMIT=3

# 强制审核：所有写操作先落草稿，人点「发」才出去。别关
REVIEW_REQUIRED=true
